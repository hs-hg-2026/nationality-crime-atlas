{
  "schema_version": 2,
  "series": {
    "npa-prefecture-visiting-foreign-crime": {
      "publisher": "National Police Agency of Japan",
      "dataset": "Finalized crime statistics: visiting-foreigner cleared cases and persons by police statistical area",
      "parser": "npa-prefecture-table13",
      "license_url": "https://www.npa.go.jp/rules/index.html",
      "dimensions": ["year", "offense_scope", "police_statistical_area"],
      "definitions": [
        "Visiting-foreigner aggregate; no individual nationality dimension.",
        "Geography semantics are unresolved and must not be labeled as residence."
      ],
      "notes": ["UI safe label: 都道府県等別（警察統計上の集計区分）"]
    },
    "npa-all-foreign-nationality-crime": {
      "publisher": "National Police Agency of Japan",
      "dataset": "Detailed crime statistics: all-foreigner cleared cases and persons by nationality",
      "parser": "npa-nationality",
      "license_url": "https://www.npa.go.jp/rules/index.html",
      "dimensions": ["year", "nationality_or_region", "offense_scope"],
      "definitions": ["National totals only; no prefecture dimension."],
      "notes": ["China includes Taiwan and Hong Kong, among others, in the source table."]
    },
    "npa-visiting-foreign-nationality-crime": {
      "publisher": "National Police Agency of Japan",
      "dataset": "Detailed crime statistics: visiting-foreigner cleared cases and persons by nationality",
      "parser": "npa-nationality",
      "license_url": "https://www.npa.go.jp/rules/index.html",
      "dimensions": ["year", "nationality_or_region", "offense_scope"],
      "definitions": ["National totals for the NPA visiting-foreigner category only."],
      "notes": ["China includes Taiwan and Hong Kong, among others, in the source table."]
    },
    "isa-resident-foreigner-population-t1": {
      "publisher": "Immigration Services Agency of Japan",
      "dataset": "Resident-foreigner statistics Table 1",
      "parser": "population-t1",
      "license_url": "https://www.e-stat.go.jp/terms-of-use",
      "dimensions": [
        "period_end",
        "nationality_or_region",
        "residence_status",
        "sex",
        "age",
        "prefecture"
      ],
      "definitions": [
        "Resident-foreigner stock at period end; not definitionally identical to NPA offender categories."
      ],
      "notes": ["Table 1 is used as the population denominator source."]
    },
    "npa-all-persons-prefecture-crime": {
      "publisher": "National Police Agency of Japan",
      "dataset": "Detailed crime statistics Table 3: all-person criminal-code counts by police statistical area",
      "parser": "npa-overall-prefecture-crime",
      "license_url": "https://www.npa.go.jp/rules/index.html",
      "dimensions": ["year", "offense_scope", "police_statistical_area"],
      "definitions": [
        "All-person recognized cases, cleared cases, and cleared persons for criminal-code offenses excluding traffic-related negligence.",
        "Prefecture labels are police-statistics geographies and are not offender residence."
      ],
      "notes": ["Provides the nationality-neutral regional context; it is not a nationality-specific numerator."]
    },
    "npa-total-population-prefecture": {
      "publisher": "National Police Agency of Japan; underlying population source: Statistics Bureau of Japan",
      "dataset": "Detailed crime statistics Table 144: total population by prefecture",
      "parser": "npa-prefecture-population",
      "license_url": "https://www.npa.go.jp/rules/index.html",
      "dimensions": ["year", "reference_date", "prefecture"],
      "definitions": [
        "Total population from Statistics Bureau population estimates and censuses as of October 1.",
        "Published in units of 1,000 persons and rounded; normalized population preserves this limitation in explicit source-unit and rounding fields."
      ],
      "notes": ["Primary all-resident denominator for the same-year regional context."]
    },
    "statistics-bureau-japanese-population-prefecture": {
      "publisher": "Statistics Bureau of Japan",
      "dataset": "Population Estimates 2024 Table 2: total and Japanese-national population by prefecture and sex",
      "parser": "statistics-bureau-japanese-population",
      "license_url": "https://www.stat.go.jp/info/riyou.html",
      "dimensions": ["year", "reference_date", "prefecture", "nationality_scope"],
      "definitions": [
        "Japanese-national population estimated as of October 1; this is not the total resident population.",
        "Published in units of 1,000 persons and rounded; normalized population preserves this limitation in explicit source-unit and rounding fields."
      ],
      "notes": [
        "Used only as the denominator for the derived Japanese-national reference row and not as a prefecture-level nationality numerator."
      ]
    }
  },
